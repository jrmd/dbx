+#[cfg(test)]
+mod identity_tests {
+    use super::*;
+    use crate::table::Column;
+    use gpui::{Entity, RenderOnce, SharedString};
+    use std::{cell::RefCell, collections::HashMap};
+
+    type FocusRecords = Rc<RefCell<HashMap<String, FocusHandle>>>;
+
+    #[derive(gpui::IntoElement)]
+    struct FocusProbe {
+        name: String,
+        records: FocusRecords,
+    }
+    impl RenderOnce for FocusProbe {
+        fn render(self, window: &mut Window, cx: &mut App) -> impl IntoElement {
+            let state = window.use_keyed_state("identity-probe", cx, |_, cx| cx.focus_handle());
+            let focus = state.read(cx).clone();
+            self.records
+                .borrow_mut()
+                .insert(self.name.clone(), focus.clone());
+            div()
+                .id("probe")
+                .size_full()
+                .track_focus(&focus)
+                .tab_index(0)
+                .child(self.name)
+        }
+    }
+
+    struct Delegate {
+        rows: Vec<&'static str>,
+        columns: Vec<Column>,
+        records: FocusRecords,
+    }
+    impl TableDelegate for Delegate {
+        fn columns_count(&self, _: &App) -> usize {
+            self.columns.len()
+        }
+        fn rows_count(&self, _: &App) -> usize {
+            self.rows.len()
+        }
+        fn column(&self, col: usize, _: &App) -> Column {
+            self.columns[col].clone()
+        }
+        fn render_tr(
+            &mut self,
+            row: usize,
+            _: &mut Window,
+            _: &mut Context<TableState<Self>>,
+        ) -> Stateful<Div> {
+            div().id(SharedString::from(
+                self.rows
+                    .get(row)
+                    .map(|name| format!("row-{name}"))
+                    .unwrap_or_else(|| format!("empty-{row}")),
+            ))
+        }
+        fn render_th(
+            &mut self,
+            col: usize,
+            _: &mut Window,
+            _: &mut Context<TableState<Self>>,
+        ) -> impl IntoElement {
+            FocusProbe {
+                name: format!("header:{}", self.columns[col].key),
+                records: self.records.clone(),
+            }
+        }
+        fn render_td(
+            &mut self,
+            row: usize,
+            col: usize,
+            _: &mut Window,
+            _: &mut Context<TableState<Self>>,
+        ) -> impl IntoElement {
+            FocusProbe {
+                name: format!("{}:{}", self.rows[row], self.columns[col].key),
+                records: self.records.clone(),
+            }
+        }
+    }
+    struct Harness {
+        table: Entity<TableState<Delegate>>,
+    }
+    impl Render for Harness {
+        fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+            super::super::DataTable::new(&self.table)
+        }
+    }
+
+    #[gpui::test]
+    fn table_cell_and_header_state_follow_stable_rows_and_columns(cx: &mut gpui::TestAppContext) {
+        cx.update(crate::init);
+        let records = FocusRecords::default();
+        let (view, cx) = cx.add_window_view(|window, cx| Harness {
+            table: cx.new(|cx| {
+                TableState::new(
+                    Delegate {
+                        rows: vec!["a", "b"],
+                        columns: vec![
+                            Column::new("fixed", "Fixed")
+                                .width(px(100.))
+                                .fixed(ColumnFixed::Left),
+                            Column::new("left", "Left").width(px(100.)),
+                            Column::new("right", "Right").width(px(100.)),
+                        ],
+                        records: records.clone(),
+                    },
+                    window,
+                    cx,
+                )
+            }),
+        });
+        cx.simulate_resize(gpui::size(px(500.), px(300.)));
+        cx.update(|window, cx| window.draw(cx).clear(cx));
+        let before = records.borrow().clone();
+        assert_eq!(before.len(), 9, "three headers and both rows must render");
+        cx.update(|_, cx| {
+            let table = view.read(cx).table.clone();
+            table.update(cx, |table, cx| {
+                table.delegate_mut().rows.reverse();
+                table.refresh(cx);
+            });
+        });
+        cx.update(|window, cx| window.draw(cx).clear(cx));
+        assert_eq!(
+            *records.borrow(),
+            before,
+            "sorting must retain each logical cell's scoped state"
+        );
+        cx.update(|_, cx| {
+            let table = view.read(cx).table.clone();
+            table.update(cx, |table, cx| {
+                table.delegate_mut().columns.swap(1, 2);
+                table.refresh(cx);
+            });
+        });
+        cx.update(|window, cx| window.draw(cx).clear(cx));
+        assert_eq!(
+            *records.borrow(),
+            before,
+            "reordering must retain cells and header state by column key"
+        );
+    }
+}
