+        let xml = xml(&cell);
+        // A ((so)) Table property causes libatspi's libdbus decoder to abort.
+        property(&xml, "Table", "(so)");
+        property(&xml, "Position", "(ii)");
+        property(&xml, "RowSpan", "i");
