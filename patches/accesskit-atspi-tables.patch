+                self.selected_rows
+                    .iter()
+                    .flat_map(|(start, end)| *start..*end),
+            );
+        }
+        indices.sort_unstable();
+        indices.dedup();
+        Ok(indices
+            .into_iter()
+            .filter(|index| self.selected_axis(*index, rows))
+            .map(|index| index as i32)
+            .collect())
+    }
+}
